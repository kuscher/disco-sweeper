<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the test hooks ./ds debug drives. Never in a release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Starts with the process and remembers the live activity for the receiver. -->
        <provider
            android:name="io.github.kuscher.discosweeper.debug.DebugHooks"
            android:authorities="io.github.kuscher.discosweeper.debughooks"
            android:exported="false"/>
        <!-- DUMP is held by the shell (adb) and not by ordinary apps. -->
        <receiver
            android:name="io.github.kuscher.discosweeper.debug.DebugHooks$Receiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.kuscher.discosweeper.DEBUG"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
