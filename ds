#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Disco Sweeper dev helper: build, install and drive the app on a device over adb.
#
#   ./ds build [release]   assemble the debug (or release) APK
#   ./ds sim               the board-fit and solver checks (plain Java, no device, no Gradle)
#   ./ds run               build, install and launch the debug APK
#   ./ds install [APK]     install the debug APK (or the one given)
#   ./ds launch | stop     start or force-stop the app
#   ./ds logs [N]          the app's log lines and any crash
#   ./ds crashes           this app's crashes (the crash log, other processes left out)
#   ./ds focused           exits 0 when this app's window has focus
#   ./ds back              the Back key, sent only while this app has focus
#   ./ds debug CMD...      test hooks in debug builds (app/src/debug/.../DebugHooks.java): dump,
#                          cell C R [left|right|middle|both|touch|hold], edge C top|bottom,
#                          click TEXT, at TEXT FX FY, shown TEXT, recreate, shot NAME, pick, solve
#   ./ds pull NAME [FILE]  fetch a `debug shot NAME` render (the app's own views, nothing else)
#   ./ds shot [FILE]       a screen capture cropped to the app's window. It shows whatever covers
#                          the window too, so only use it when the device is yours to use;
#                          `debug shot` is the safe one while someone is working on the device.
#
# adb's server listens on a Unix socket (VSCodeBook's), never tcp:5037: the Linux terminal
# forwards every TCP port to Android, where any app could reach it.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
PKG=io.github.kuscher.discosweeper
ACT="$PKG/.MainActivity"
APK=app/build/outputs/apk/debug/app-debug.apk
ENVF="$HOME/.config/vscodebook/android.env"
[ -f "$ENVF" ] && . "$ENVF"
export ADB_SERVER_SOCKET=${ADB_SERVER_SOCKET:-localfilesystem:$HOME/.local/state/vscodebook/adb.sock}
TMP=${XDG_RUNTIME_DIR:-/tmp}

serial() { cat "$HOME/.config/vscodebook/adb-serial" 2>/dev/null; }
connect() {
  if [ -n "${ANDROID_SERIAL:-}" ]; then echo "$ANDROID_SERIAL"; return; fi   # CI's emulator
  local s; s="$(serial)"
  if [ -n "$s" ] && adb -s "$s" shell true >/dev/null 2>&1; then echo "$s"; return; fi
  vscodebook android connect >/dev/null 2>&1 || true
  serial
}
A() { adb -s "$(connect)" "$@"; }
# Test hooks dispatch input straight into the app's own views, never into the system: they can
# only ever click Disco Sweeper, whatever else is on the screen.
dbg() { A shell "am broadcast --user current -a $PKG.DEBUG -p $PKG --es c '$*'" >/dev/null; sleep "${DBG_WAIT:-0.8}"
  { A shell "logcat -d -s DiscoSweeper:I" | grep "debug $1" || true; } | tail -1 | sed 's/.*-> //'; }
focused() { A shell dumpsys window | grep -m1 mCurrentFocus | grep -q "$PKG/"; }
pull() { A exec-out run-as "$PKG" cat "cache/$1.png" > "${2:-$TMP/$1.png}" && echo "${2:-$TMP/$1.png}"; }

build() {
  if [ "${1:-}" = release ]; then ./gradlew :app:assembleRelease --console=plain -q
  else ./gradlew :app:assembleDebug --console=plain -q; fi
}

sim() {
  local out; out=$(mktemp -d)
  javac -d "$out" app/src/main/java/io/github/kuscher/discosweeper/game/{Fit,Level,Board,Solver}.java app/sim/*.java
  java -cp "$out" Sim && java -cp "$out" SolverSim
  rm -rf "$out"
}

install() {
  local s; s="$(connect)"
  adb -s "$s" shell settings put global verifier_verify_adb_installs 0
  adb -s "$s" install -r "${1:-$APK}" || { adb -s "$s" shell settings put global verifier_verify_adb_installs 1; exit 1; }
  adb -s "$s" shell settings put global verifier_verify_adb_installs 1
}

# Opens in a desktop window (windowing mode 5 = freeform), never full screen. CI's emulator has no
# desktop windowing, so it sets DS_WINDOWING_MODE to empty.
launch() { local m=${DS_WINDOWING_MODE-5}; A shell am start --user current ${m:+--windowingMode $m} -n "$ACT" >/dev/null; }

shot() { # the app's window, from its frame in dumpsys
  local out=${1:-$TMP/discosweeper.png}
  read -r x1 y1 x2 y2 < <(A shell dumpsys window windows | awk -v pkg="$PKG/" '/Window #/ { m = index($0, pkg) > 0 } m && /frame=\[/ { print }' |
    grep -o 'frame=\[[0-9-]*,[0-9-]*\]\[[0-9]*,[0-9]*\]' | tr -c '0-9\n-' ' ' |
    awk '{ a = ($3 - $1) * ($4 - $2); if (a > best) { best = a; line = $1 " " $2 " " $3 " " $4 } } END { print line }')
  [ -n "${x1:-}" ] || { echo "Disco Sweeper isn't open" >&2; exit 1; }
  A exec-out screencap -p > "$out.full"
  python3 -c "import sys; from PIL import Image; Image.open(sys.argv[1]).crop(tuple(max(0, int(v)) for v in sys.argv[3:7])).save(sys.argv[2])" "$out.full" "$out" "$x1" "$y1" "$x2" "$y2"
  rm -f "$out.full"; echo "$out"
}

case "${1:-}" in
  build) shift; build "$@" ;;
  sim) sim ;;
  run) build; install; launch ;;
  install) shift; install "$@" ;;
  launch) launch ;;
  stop) A shell am force-stop --user current "$PKG" ;;
  logs) A shell "logcat -d --pid=\$(pidof $PKG) 2>/dev/null; logcat -d -s AndroidRuntime:E" | tail -"${2:-40}" ;;
  crashes) A shell logcat -d -b crash | grep -A 12 "Process: $PKG" || true ;;   # this app's only
  focused) focused ;;
  back) focused || { echo "Disco Sweeper doesn't have focus; Back not sent. Focus:" >&2
      A shell dumpsys window | grep -m2 -E "mCurrentFocus|mFocusedApp" >&2; exit 1; }
    A shell input keyevent KEYCODE_BACK ;;
  shot) shift; shot "$@" ;;
  debug) shift; dbg "$@" ;;
  pull) shift; pull "$@" ;;
  *) sed -n '3,24p' "$0"; exit 1 ;;
esac
